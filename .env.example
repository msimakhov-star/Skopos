# Reactor — https://reactor.inc/account/api-keys
REACTOR_API_KEY=
REACTOR_MODEL=reactor/lingbot-world-2

# Perception VLM (optional; mock perception is used when unset)
ANTHROPIC_API_KEY=

# Runware fallback — https://my.runware.ai
RUNWARE_API_KEY=

# Provider: mock | reactor
SKOPOS_PROVIDER=mock
SKOPOS_SEED=1337
# Write raw frames to disk for debugging. MUST stay 0 for any real scan.
SKOPOS_DEBUG_KEEP_FRAMES=0
